# Supabase → Project → Connect.
# App connection: "Transaction pooler" (port 6543).
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
# Migrations: "Session pooler" (port 5432).
DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# First admin account (must be changed at first sign-in).
ADMIN_USERNAME="admin"
ADMIN_INITIAL_PASSWORD="choose-a-temporary-password"

# Protects the daily cron job. Any long random string.
CRON_SECRET="long-random-string"
